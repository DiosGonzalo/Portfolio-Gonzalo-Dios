---
const SOCIAL_LINKS = [
    { name: "LinkedIn", icon: "🔗", href: "https://www.linkedin.com/in/gonzalo-dios-6a1810293" }, 
    { name: "GitHub", icon: "🐙", href: "https://github.com/DiosGonzalo" },

];
---

<section id="contacto" class="py-20 px-8 bg-gray-900">
    <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-bold text-center text-white mb-6">
            Contact Me
        </h2>
        <p class="text-center text-gray-400 mb-12 max-w-lg mx-auto">
            I am open to new job opportunities or collaboration projects.
        </p>

        <div class="flex flex-col md:flex-row gap-12">
            
            <div class="md:w-2/3">
                <form action="YOUR_FORM_ENDPOINT" method="POST" class="space-y-6">
                    <div>
                        <label for="name" class="block text-sm font-medium text-gray-300 mb-1">Nombre</label>
                        <input type="text" id="name" name="name" required class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white focus:ring-blue-500 focus:border-blue-500 transition duration-200">
                    </div>
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-300 mb-1">Email</label>
                        <input type="email" id="email" name="email" required class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white focus:ring-blue-500 focus:border-blue-500 transition duration-200">
                    </div>
                    <div>
                        <label for="message" class="block text-sm font-medium text-gray-300 mb-1">Mensaje</label>
                        <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white focus:ring-blue-500 focus:border-blue-500 transition duration-200"></textarea>
                    </div>
                    
                    <button type="submit" class="w-full px-6 py-3 text-lg font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition duration-300">
                        Enviar Mensaje
                    </button>
                </form>
            </div>

            <div class="md:w-1/3 bg-gray-800 p-6 rounded-xl border border-gray-700 flex flex-col justify-center">
                <h3 class="text-2xl font-semibold text-white mb-4">Información de Contacto</h3>
                
                <p class="text-gray-400 mb-6">
                    I prefer communication via email for detailed inquiries.
                </p>

                <div class="space-y-4">
                    <div class="flex items-center space-x-3 text-gray-300">
                        <span class="text-yellow-400">📧</span>
                        <a href="mailto:gdiosfiestas@gmail.com" class="hover:text-blue-400">gdiosfiestas@gmail.com</a>
                    </div>
                    <div class="flex items-center space-x-3 text-gray-300">
                        <span class="text-yellow-400">📍</span>
                        <p>Sevilla, Spain (Remote)</p>
                    </div>
                </div>

                <div class="mt-8 pt-4 border-t border-gray-700">
                    <h4 class="text-xl font-semibold text-white mb-3">Follow Me</h4>
                    <div class="flex space-x-4">
                        {SOCIAL_LINKS.map((link) => (
                            <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-2xl text-gray-400 hover:text-blue-400 transition duration-200" aria-label={link.name}>
                                {link.icon} {link.name}
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>