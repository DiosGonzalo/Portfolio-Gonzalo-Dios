---
// Modificamos la estructura de los datos para usar una lista de puntos y un stack de tecnologías
const EXPERIENCE_DATA = [
    {
        year: "July 2025 - Sept 2025",
        title: "Web developer Full Stack",
        company: "Geolen Sl",
        bulletPoints: [
            "Managed and optimized the company website.",
            "Designed enterprise workflow automation.",
            "Initiated and developed an employee productivity tracking application."
        ],
        techStack: ["WordPress", "SharePoint", "Power Automate", "Application Development"]
    },
    {
        year: "February 2025 - April 2025",
        title: "Full Stack Developer Intern",
        company: "VinaFiel",
        bulletPoints: [
            "Managed seasonal sales campaigns and promotions.",
            "Worked on the company's website using Prestashop.",
            "Assisted with general IT maintenance and troubleshooting (Windows)."
        ],
        techStack: ["Prestashop", "HTML/CSS", "IT Support"]
    },
];

// Helper functions to generate class strings (avoid bracketed Tailwind in template)
const getContainerClass = (index: number) =>
  `flex relative group ${index % 2 === 0 ? "md:justify-start" : "md:justify-end"}`;

const getMarkerClass = (index: number) =>
  `hidden md:flex absolute top-1/2 transform -translate-y-1/2 items-center justify-center w-6 h-6 rounded-full bg-blue-600 border-4 border-gray-900 z-10 transition duration-300 ${
    index % 2 === 0 ? "md:left-1/2 md:-translate-x-full" : "md:right-1/2 md:translate-x-full"
  }`;

const getCardClass = () =>
  "w-full md:w-1/2 p-6 bg-gray-800 rounded-xl shadow-xl border border-gray-700 transition duration-500 transform group-hover:scale-105 group-hover:shadow-blue-500/50";
---

<section id="experiencia" class="py-20 px-8 bg-gray-900">
    <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-bold text-center text-white mb-12">
            Experiencia & Formación
        </h2>

        <div class="space-y-12 relative">
            <div class="absolute left-1/2 transform -translate-x-1/2 w-0.5 bg-blue-600 h-full hidden md:block"></div>

            {EXPERIENCE_DATA.map((item, index) => (
                <div class={getContainerClass(index)}>
                    
                    <div class={getMarkerClass(index)}></div>

                    <div class={getCardClass()}>
                        
                        <div class="mb-3 border-b border-gray-700 pb-2">
                            <span class="text-sm font-semibold text-yellow-400 mb-1 block">{item.year}</span>
                            <h3 class="text-2xl font-bold text-white mb-0.5">{item.title}</h3>
                            <p class="text-md font-medium text-gray-400">{item.company}</p>
                        </div>
                        
                        <ul class="list-disc list-inside space-y-2 text-gray-300 ml-4 mb-4">
                            {item.bulletPoints.map(point => (
                                <li>{point}</li>
                            ))}
                        </ul>

                        <div class="flex flex-wrap gap-2 pt-2 border-t border-gray-700">
                            {item.techStack.map(tech => (
                                <span class="px-3 py-1 text-xs font-medium bg-gray-700 text-green-400 rounded-full">
                                    {tech}
                                </span>
                            ))}
                        </div>
                    </div>

                </div>
            ))} 
        </div>
    </div>
</section>