---
const NAV_ITEMS = [
    { title: "Inicio", href: "#hero" },
    { title: "Sobre Mí", href: "#sobre-mi" },
    { title: "Proyectos", href: "#proyectos" },
    { title: "Experiencia", href: "#experiencia" },
    { title: "Tecnologías", href: "#tecnologias" },
    { title: "Contacto", href: "#contacto" },
];
---

<header class="sticky top-0 z-50 bg-gray-900/90 backdrop-blur-sm border-b border-blue-900/50">
    <div class="max-w-6xl mx-auto px-8 py-4 flex justify-between items-center">
        <a  class="text-2xl font-bold text-white hover:text-yellow-400 transition duration-300">
            &lt;DevGoncha/&gt;
        </a>

        <nav class="hidden md:flex space-x-6">
            {NAV_ITEMS.map((item) => (
                <a 
                    href={item.href} 
                    class="text-gray-300 hover:text-blue-400 font-medium transition duration-200"
                >
                    {item.title}
                </a>
            ))}
        </nav>

        <a href="../../public/Cv_Gonzalo_Dios_Fiestas.pdf" download class="hidden md:block px-4 py-2 text-sm font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition duration-300">
            Descargar CV
        </a>
    </div>
</header>