---
const name = "Gonzalo";
const role = "Full Stack Web Developer";
const intro = "I am a full-stack developer, with preference for back-end development, currently learning Machine Learning and AI integration, but also experienced in a lot of other modern technologies.";
const ctaText = "Projects";
const ctaLink = "#projects";
---

<section id="hero" class="h-screen flex items-center justify-center p-8 bg-gray-900">
    <div class="max-w-4xl text-center">
        
        <h1 class="text-6xl font-extrabold text-white mb-4">
            Hello, I am <span class="text-yellow-400">{name}</span>
        </h1>
        <p class="text-2xl text-gray-400 mb-6">
            {role}
        </p>
        <p class="text-lg text-gray-400 mb-10 max-w-2xl mx-auto">
            {intro}
        </p>
        <a href={ctaLink} class="px-8 py-3 text-lg font-semibold rounded-full bg-blue-600 text-white hover:bg-blue-700 transition duration-300 shadow-lg">
            {ctaText}
        </a>
    </div>
</section>